{
  "name": "website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "check:data": "node scripts/validate-data.mjs",
    "check:data:review": "node scripts/validate-data.mjs --allow-pending",
    "test": "node scripts/build-reviewed-fixture.mjs && node --test tests/*.test.mjs",
    "build": "npm run check:data && astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "tailwindcss": "^4.3.3"
  }
}
