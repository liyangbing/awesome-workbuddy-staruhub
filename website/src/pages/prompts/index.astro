---
import Layout from '../../layouts/Layout.astro';
import { withBase } from '../../lib/catalog.mjs';
import { buildPromptSearchText } from '../../lib/prompt-search.mjs';
import { loadPrompts } from '../../lib/prompts.mjs';
import { loadPromptRuns } from '../../lib/prompt-runs.mjs';

const base = import.meta.env.BASE_URL;
const homeHref = withBase(base, '/');
const resourcesHref = withBase(base, '/#resources');
const { prompts, counts } = loadPrompts();
const runsByPromptId = loadPromptRuns({ prompts });
const promptsWithRuns = prompts.map((prompt) => ({
  ...prompt,
  recordedRun: runsByPromptId.get(prompt.id),
}));

const CATEGORY_LABELS = {
  'deep-research': '深度调研',
  'data-analysis': '数据分析',
  'doc-writing': '文档写作',
  ppt: 'PPT 制作',
  meeting: '会议协作',
  'email-calendar': '邮件与日程',
  'project-mgmt': '项目管理',
  dev: '开发提效',
  growth: '增长运营',
  'admin-hr-finance': '行政人事财务',
};

const categoryFilters = Object.entries(counts).map(([key, count]) => ({
  key,
  count,
  label: CATEGORY_LABELS[key],
}));

---

<Layout
  title={`${prompts.length} 条 WorkBuddy 工作提效 Prompts`}
  description="搜索、筛选并复制 100 条 WorkBuddy 工作提效提示词；查看已保存、独立审核后的静态效果预览。"
>
  <style is:inline>
    html, body { margin:0; padding:0; background:var(--bgpage); }
    * { box-sizing:border-box; }
    ::selection { background:#12B981; color:#fff; }
    a { color:inherit; text-decoration:none; }
    button, input { font:inherit; }
    [data-wb-vars] { --bgpage:#FFFFFF; --bgsoft:#F5F8F7; --card:#FFFFFF; --cardhover:#FBFEFD; --headbg:rgba(255,255,255,0.9); --ink:#0B0F0E; --t2:#5C6664; --t3:#6B7573; --t4:#7A8582; --t6:#9AA4A1; --line:#E5EAE8; --line2:#F0F3F2; --ghost:#E9EDEB; }
    [data-wb-theme="dark"] { --bgpage:#0F1514; --bgsoft:#121917; --card:#151D1B; --cardhover:#1A2523; --headbg:rgba(15,21,20,0.88); --ink:#F0F4F3; --t2:#A9B5B1; --t3:#97A39F; --t4:#8A9692; --t6:#616D69; --line:#242E2B; --line2:#1D2724; --ghost:#182220; }
    [data-wb-theme="dark"] #prompt-logo { filter:brightness(0) invert(1); }
    .prompt-card[hidden] { display:none !important; }
    .filter-chip[aria-pressed="true"] { background:#12B981 !important; border-color:#12B981 !important; color:#fff !important; }
    .copy-button:focus-visible, .trial-button:focus-visible, .filter-chip:focus-visible, #prompt-search:focus-visible, a:focus-visible, #theme-toggle:focus-visible, .trial-modal-button:focus-visible { outline:3px solid rgba(18,185,129,0.35); outline-offset:3px; }
    .trial-modal-button:disabled { opacity:.45; cursor:not-allowed !important; }
    #trial-modal[hidden] { display:none !important; }
    #trial-output::after { content:""; display:inline-block; width:7px; height:1em; margin-left:3px; vertical-align:-0.12em; background:#12B981; animation:trial-caret .8s steps(1,end) infinite; }
    #trial-output[data-complete="true"]::after { display:none; }
    @keyframes trial-caret { 50% { opacity:0; } }
    @media (prefers-reduced-motion:reduce) {
      #trial-output::after { animation:none; }
    }
    @media (max-width:760px) {
      [data-wrap] { padding-left:20px !important; padding-right:20px !important; }
      #prompt-header-source { display:none !important; }
      #prompt-hero { padding-top:58px !important; padding-bottom:48px !important; }
      #prompt-h1 { font-size:42px !important; }
      #prompt-grid { grid-template-columns:1fr !important; }
    }
    @media (max-width:480px) {
      #prompt-h1 { font-size:34px !important; }
      #prompt-toolbar { padding:18px 0 !important; }
      #trial-dialog { padding:20px !important; border-radius:16px !important; }
      #trial-output { min-height:300px !important; }
    }
  </style>

  <div data-wb-vars="1" data-wb-theme="light" id="prompt-root" style="min-height:100vh; font-family:'Noto Sans SC','Archivo',system-ui,sans-serif; color:var(--ink); background:var(--bgpage); transition:background .3s ease,color .3s ease;">
    <header style="position:sticky; top:0; z-index:30; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; height:68px; margin:0 auto; padding:0 32px; display:flex; align-items:center; gap:22px;">
        <a href={homeHref} aria-label="返回 Awesome WorkBuddy 首页" style="display:flex; align-items:center;">
          <img id="prompt-logo" src={`${base}/uploads/workbuddy-logo.png`} alt="WorkBuddy" style="height:30px; width:auto; display:block;" />
        </a>
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t6);">/ PROMPTS</span>
        <div style="flex:1;"></div>
        <a id="prompt-header-source" href="https://github.com/staruhub/awesome-workbuddy/blob/main/prompts/100-work-efficiency-prompts.json" target="_blank" rel="noopener noreferrer" style="font-size:13px; color:var(--t3);">查看源数据 ↗</a>
        <button id="theme-toggle" type="button" title="切换深浅色" aria-label="切换深浅色" style="width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); cursor:pointer; font-size:15px; display:flex; align-items:center; justify-content:center;">&#9790;</button>
      </div>
    </header>

    <section style="position:relative; overflow:hidden; background:linear-gradient(180deg,var(--bgpage),var(--bgsoft)); border-bottom:1px solid var(--line);">
      <div style="position:absolute; right:-70px; bottom:-54px; font-family:'Archivo',sans-serif; font-weight:900; font-size:170px; color:var(--ghost); letter-spacing:-0.05em; pointer-events:none;">100</div>
      <div id="prompt-hero" data-wrap="1" style="position:relative; max-width:1240px; margin:0 auto; padding:84px 32px 66px;">
        <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#12B981; margin-bottom:16px;">PROMPT LIBRARY · SEARCHABLE &amp; EVIDENCE-BACKED</div>
        <h1 id="prompt-h1" style="max-width:850px; margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-size:64px; line-height:1.02; font-weight:900; letter-spacing:-0.045em;">{prompts.length} 条工作提效 Prompts</h1>
        <p style="max-width:760px; margin:22px 0 0; font-size:16px; line-height:1.85; color:var(--t2);">按场景筛选并一键复制给 WorkBuddy。每个「试运行」只流式回放已保存并通过独立审核的 UTF-8 Markdown 正文；点击时不会现场调用模型、API 或本地文件。</p>
        <div style="display:flex; gap:12px; margin-top:30px; flex-wrap:wrap;">
          <a href={resourcesHref} style="display:inline-flex; align-items:center; background:#12B981; color:#fff; font-size:14px; font-weight:700; padding:13px 22px; border-radius:11px;">← 返回资源清单</a>
          <a href="https://github.com/staruhub/awesome-workbuddy/blob/main/prompts/100-work-efficiency-prompts.json" target="_blank" rel="noopener noreferrer" style="display:inline-flex; align-items:center; background:var(--card); border:1px solid var(--line); color:var(--ink); font-size:14px; font-weight:700; padding:13px 22px; border-radius:11px;">GitHub 源文件 ↗</a>
        </div>
      </div>
    </section>

    <div style="position:sticky; top:68px; z-index:20; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div id="prompt-toolbar" data-wrap="1" style="max-width:1240px; margin:0 auto; padding:20px 32px;">
        <label for="prompt-search" style="display:block; font-size:13px; font-weight:700; margin-bottom:9px;">搜索标题、场景、指令、交付物或技巧</label>
        <input id="prompt-search" type="search" autocomplete="off" placeholder="例如：竞品、会议纪要、Excel、招聘……" aria-controls="prompt-grid" style="width:100%; height:48px; padding:0 16px; color:var(--ink); background:var(--card); border:1px solid var(--line); border-radius:12px; font-size:15px;" />
        <div role="group" aria-label="按提示词分类筛选" style="display:flex; gap:8px; margin-top:13px; overflow-x:auto; padding-bottom:2px;">
          <button type="button" class="filter-chip" data-category="all" aria-pressed="true" style="flex:0 0 auto; border:1px solid #12B981; background:#12B981; color:#fff; padding:8px 14px; border-radius:999px; cursor:pointer; font-size:13px; font-weight:700;">全部 {prompts.length}</button>
          {categoryFilters.map((category) => (
            <button type="button" class="filter-chip" data-category={category.key} aria-pressed="false" style="flex:0 0 auto; border:1px solid var(--line); background:var(--card); color:var(--t2); padding:8px 14px; border-radius:999px; cursor:pointer; font-size:13px; font-weight:700;">{category.label} {category.count}</button>
          ))}
        </div>
      </div>
    </div>

    <main data-wrap="1" style="max-width:1240px; margin:0 auto; padding:38px 32px 84px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:24px;">
        <p id="result-count" role="status" aria-live="polite" style="margin:0; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t4);">显示 {prompts.length} 条</p>
        <span style="height:1px; flex:1; background:var(--line2);"></span>
      </div>

      <div id="empty-state" role="status" aria-live="polite" hidden style="border:1px dashed var(--line); border-radius:16px; padding:52px 24px; text-align:center; background:var(--bgsoft);">
        <h2 style="margin:0; font-size:22px;">没找到匹配的 Prompt</h2>
        <p style="margin:10px 0 0; color:var(--t3);">换个关键词，或者点「全部」再试试。</p>
      </div>

      <div id="prompt-grid" style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(360px,100%),1fr)); gap:16px;">
        {promptsWithRuns.map((prompt) => (
          <article class="prompt-card" data-prompt-card data-category={prompt.category} data-search={buildPromptSearchText(prompt)} style="position:relative; display:flex; flex-direction:column; overflow:hidden; border:1px solid var(--line); border-radius:16px; background:var(--card); padding:24px;">
            <div style="position:absolute; right:14px; top:0; font-family:'Archivo',sans-serif; font-size:60px; font-weight:900; color:var(--ghost); letter-spacing:-0.05em; pointer-events:none;">{String(prompt.id).padStart(2, '0')}</div>
            <div style="position:relative; font-family:'JetBrains Mono',monospace; font-size:11px; color:#12B981;">{CATEGORY_LABELS[prompt.category]} · {prompt.category}</div>
            <h2 style="position:relative; margin:11px 0 0; padding-right:28px; font-size:19px; line-height:1.42; letter-spacing:-0.015em;">{prompt.title}</h2>
            <p style="margin:8px 0 0; font-size:12.5px; color:var(--t4);">{prompt.scene}</p>
            <p class="prompt-copy-source" style="margin:18px 0 0; font-size:13.5px; line-height:1.82; color:var(--t2); white-space:pre-wrap;">{prompt.prompt}</p>
            <div style="flex:1; min-height:18px;"></div>
            <div style="margin-top:18px; padding-top:16px; border-top:1px solid var(--line2);">
              <div style="font-size:12px; font-weight:700; color:var(--ink);">预期交付物</div>
              <p style="margin:6px 0 0; font-size:12.5px; line-height:1.65; color:var(--t3);">{prompt.expected_output}</p>
            </div>
            <div style="margin-top:13px; padding:11px 13px; background:rgba(18,185,129,0.08); border-left:2px solid #12B981; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65; color:var(--t2);">Tip · {prompt.tip}</div>
            <div style="margin-top:16px; display:flex; align-items:center; gap:10px; flex-wrap:wrap;">
              <button type="button" class="copy-button" data-copy-prompt aria-label={`复制提示词：${prompt.title}`} style="align-self:flex-start; border:1px solid var(--line); background:var(--bgsoft); color:var(--ink); border-radius:9px; padding:9px 14px; cursor:pointer; font-size:12.5px; font-weight:700;">复制 Prompt</button>
              <button
                type="button"
                class="trial-button"
                data-trial-run
                aria-label={`回放实测结果：${prompt.title}`}
                style="align-self:flex-start; border:1px solid #12B981; background:#12B981; color:#fff; border-radius:9px; padding:9px 14px; cursor:pointer; font-size:12.5px; font-weight:700;"
              >试运行</button>
            </div>
            <template data-trial-preview>{prompt.recordedRun.output}</template>
          </article>
        ))}
      </div>
      <p id="copy-status" role="status" aria-live="polite" aria-atomic="true" style="position:fixed; left:-10000px; width:1px; height:1px; overflow:hidden;"></p>
      <noscript><p style="margin-top:28px; color:var(--t3);">未启用 JavaScript：全部提示词仍可阅读，但搜索、筛选和复制按钮不可用。</p></noscript>
    </main>

    <div id="trial-modal" hidden role="presentation" style="position:fixed; inset:0; z-index:100; display:grid; place-items:center; padding:20px; background:rgba(5,12,10,0.68); backdrop-filter:blur(8px);">
      <section id="trial-dialog" role="dialog" aria-modal="true" aria-labelledby="trial-title" style="width:min(820px,100%); max-height:min(760px,calc(100vh - 40px)); display:flex; flex-direction:column; overflow:hidden; padding:26px; border:1px solid var(--line); border-radius:22px; background:var(--card); box-shadow:0 24px 80px rgba(0,0,0,.28);">
        <div style="display:flex; align-items:flex-start; gap:18px;">
          <div style="min-width:0; flex:1;">
            <h2 id="trial-title" style="margin:0; font-size:22px; line-height:1.35;">试运行</h2>
          </div>
          <button type="button" class="trial-modal-button" data-trial-close aria-label="关闭试运行预览" style="flex:0 0 auto; width:38px; height:38px; border:1px solid var(--line); border-radius:50%; background:var(--bgsoft); color:var(--ink); cursor:pointer; font-size:20px; line-height:1;">×</button>
        </div>
        <div style="display:flex; align-items:center; gap:10px; margin-top:20px;">
          <span id="trial-status-dot" aria-hidden="true" style="width:8px; height:8px; border-radius:50%; background:#12B981; box-shadow:0 0 0 5px rgba(18,185,129,.1);"></span>
          <p id="trial-status" role="status" aria-live="polite" style="margin:0; font-family:'JetBrains Mono',monospace; font-size:11px; color:var(--t4);">准备预览</p>
        </div>
        <pre id="trial-output" data-complete="false" tabindex="0" aria-label="已保存的实测结果" aria-busy="false" style="min-height:360px; margin:16px 0 0; padding:20px; overflow:auto; white-space:pre-wrap; overflow-wrap:anywhere; border:1px solid var(--line); border-radius:14px; background:var(--bgsoft); color:var(--ink); font:12.5px/1.8 'JetBrains Mono','Noto Sans SC',monospace;"></pre>
        <div style="display:flex; justify-content:flex-end; gap:10px; margin-top:16px; flex-wrap:wrap;">
          <button type="button" class="trial-modal-button" data-trial-skip style="border:1px solid var(--line); background:var(--bgsoft); color:var(--ink); border-radius:9px; padding:9px 14px; cursor:pointer; font-size:12.5px; font-weight:700;">立即显示</button>
          <button type="button" class="trial-modal-button" data-trial-copy disabled style="border:1px solid #12B981; background:#12B981; color:#fff; border-radius:9px; padding:9px 14px; cursor:pointer; font-size:12.5px; font-weight:700;">复制实测结果</button>
        </div>
      </section>
    </div>
  </div>

  <script is:inline>
    (function() {
      var root = document.getElementById('prompt-root');
      var themeButton = document.getElementById('theme-toggle');
      var storedTheme = null;
      try { storedTheme = localStorage.getItem('wb-theme'); } catch (error) {}
      if (storedTheme === 'dark' || storedTheme === 'light') {
        root.setAttribute('data-wb-theme', storedTheme);
      }
      function updateThemeIcon() {
        themeButton.innerHTML = root.getAttribute('data-wb-theme') === 'dark' ? '&#9788;' : '&#9790;';
      }
      updateThemeIcon();
      themeButton.addEventListener('click', function() {
        var next = root.getAttribute('data-wb-theme') === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-wb-theme', next);
        try { localStorage.setItem('wb-theme', next); } catch (error) {}
        updateThemeIcon();
      });

      var search = document.getElementById('prompt-search');
      var cards = Array.prototype.slice.call(document.querySelectorAll('[data-prompt-card]'));
      var chips = Array.prototype.slice.call(document.querySelectorAll('.filter-chip'));
      var resultCount = document.getElementById('result-count');
      var emptyState = document.getElementById('empty-state');
      var activeCategory = 'all';

      function applyFilters() {
        var query = search.value.trim().toLocaleLowerCase('zh-CN');
        var visible = 0;
        cards.forEach(function(card) {
          var categoryMatch = activeCategory === 'all' || card.getAttribute('data-category') === activeCategory;
          var searchMatch = !query || card.getAttribute('data-search').indexOf(query) !== -1;
          card.hidden = !(categoryMatch && searchMatch);
          if (!card.hidden) visible += 1;
        });
        resultCount.textContent = '显示 ' + visible + ' 条';
        emptyState.hidden = visible !== 0;
      }

      search.addEventListener('input', applyFilters);
      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          activeCategory = chip.getAttribute('data-category');
          chips.forEach(function(item) {
            item.setAttribute('aria-pressed', String(item === chip));
          });
          applyFilters();
        });
      });

      function fallbackCopy(text) {
        var textarea = document.createElement('textarea');
        textarea.value = text;
        textarea.setAttribute('readonly', '');
        textarea.style.position = 'fixed';
        textarea.style.opacity = '0';
        document.body.appendChild(textarea);
        textarea.select();
        var copied = document.execCommand('copy');
        document.body.removeChild(textarea);
        if (!copied) throw new Error('copy command failed');
      }

      function copyText(text) {
        if (navigator.clipboard && window.isSecureContext) {
          return navigator.clipboard.writeText(text);
        }
        fallbackCopy(text);
        return Promise.resolve();
      }

      var copyStatus = document.getElementById('copy-status');
      var trialModal = document.getElementById('trial-modal');
      var trialTitle = document.getElementById('trial-title');
      var trialOutput = document.getElementById('trial-output');
      var trialStatus = document.getElementById('trial-status');
      var trialSkip = trialModal.querySelector('[data-trial-skip]');
      var trialCopy = trialModal.querySelector('[data-trial-copy]');
      var trialClose = trialModal.querySelector('[data-trial-close]');
      var trialTimer = null;
      var trialText = '';
      var trialIndex = 0;
      var previousFocus = null;
      var previousBodyOverflow = '';

      function finishTrialPreview() {
        window.clearTimeout(trialTimer);
        trialTimer = null;
        trialIndex = trialText.length;
        trialOutput.textContent = trialText;
        trialOutput.scrollTop = 0;
        trialOutput.setAttribute('data-complete', 'true');
        trialOutput.setAttribute('aria-busy', 'false');
        trialStatus.textContent = '实测结果已完整展示';
        trialSkip.hidden = true;
        trialCopy.disabled = false;
      }

      function streamTrialPreview() {
        if (trialIndex >= trialText.length) {
          finishTrialPreview();
          return;
        }
        trialIndex = Math.min(trialText.length, trialIndex + 8);
        trialOutput.textContent = trialText.slice(0, trialIndex);
        trialOutput.scrollTop = trialOutput.scrollHeight;
        trialTimer = window.setTimeout(streamTrialPreview, 18);
      }

      function openTrialPreview(button) {
        var card = button.closest('[data-prompt-card]');
        if (!card) return;
        var title = card.querySelector('h2');
        var template = card.querySelector('[data-trial-preview]');
        if (!title || !template) return;

        window.clearTimeout(trialTimer);
        previousFocus = document.activeElement;
        previousBodyOverflow = document.body.style.overflow;
        trialText = template.content.textContent;
        trialIndex = 0;
        trialTitle.textContent = title.textContent + ' · 试运行';
        trialOutput.textContent = '';
        trialOutput.setAttribute('data-complete', 'false');
        trialOutput.setAttribute('aria-busy', 'true');
        trialStatus.textContent = '正在流式回放已保存的实测结果…';
        trialSkip.hidden = false;
        trialCopy.disabled = true;
        trialCopy.textContent = '复制实测结果';
        trialModal.hidden = false;
        document.body.style.overflow = 'hidden';
        trialClose.focus();

        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
          finishTrialPreview();
        } else {
          streamTrialPreview();
        }
      }

      function closeTrialPreview() {
        window.clearTimeout(trialTimer);
        trialTimer = null;
        trialOutput.setAttribute('aria-busy', 'false');
        trialModal.hidden = true;
        document.body.style.overflow = previousBodyOverflow;
        if (previousFocus && typeof previousFocus.focus === 'function') {
          previousFocus.focus();
        }
      }

      document.querySelectorAll('[data-copy-prompt]').forEach(function(button) {
        button.addEventListener('click', function() {
          var card = button.closest('[data-prompt-card]');
          var source = card.querySelector('.prompt-copy-source');
          var title = card.querySelector('h2').textContent;
          copyText(source.textContent).then(function() {
            var original = button.textContent;
            button.textContent = '已复制 ✓';
            copyStatus.textContent = '已复制提示词：' + title;
            window.setTimeout(function() { button.textContent = original; }, 1800);
          }).catch(function() {
            button.textContent = '复制失败，请手动选择';
            copyStatus.textContent = '复制失败，请手动选择提示词文本。';
            window.setTimeout(function() { button.textContent = '复制 Prompt'; }, 2400);
          });
        });
      });

      document.querySelectorAll('[data-trial-run]').forEach(function(button) {
        button.addEventListener('click', function() {
          openTrialPreview(button);
        });
      });

      trialSkip.addEventListener('click', finishTrialPreview);
      trialClose.addEventListener('click', closeTrialPreview);
      trialCopy.addEventListener('click', function() {
        copyText(trialText).then(function() {
          trialCopy.textContent = '已复制 ✓';
          copyStatus.textContent = '已复制试运行实测结果。';
          window.setTimeout(function() {
            trialCopy.textContent = '复制实测结果';
          }, 1800);
        }).catch(function() {
          trialCopy.textContent = '复制失败';
          copyStatus.textContent = '复制实测结果失败，请手动选择文本。';
        });
      });
      trialModal.addEventListener('click', function(event) {
        if (event.target === trialModal) closeTrialPreview();
      });
      document.addEventListener('keydown', function(event) {
        if (event.key === 'Escape' && !trialModal.hidden) {
          closeTrialPreview();
          return;
        }
        if (event.key === 'Tab' && !trialModal.hidden) {
          var focusable = Array.prototype.slice.call(
            trialModal.querySelectorAll(
              'button:not([disabled]), a[href], [tabindex="0"]',
            ),
          ).filter(function(element) {
            return !element.hidden;
          });
          var first = focusable[0];
          var last = focusable[focusable.length - 1];
          if (event.shiftKey && document.activeElement === first) {
            event.preventDefault();
            last.focus();
          } else if (!event.shiftKey && document.activeElement === last) {
            event.preventDefault();
            first.focus();
          }
        }
      });
    })();
  </script>
</Layout>
