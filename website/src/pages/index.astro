  { q: 'WorkBuddy 和 CodeBuddy 有什么区别？', a: 'CodeBuddy 面向开发者，聚焦写代码；WorkBuddy 面向所有职场人，覆盖调研、报表、PPT、纪要等全场景办公。两者同属腾讯「Buddy 家族」，可以配合使用。' },
  { q: 'OpenClaw 的技能能直接用吗？', a: '可以。WorkBuddy 兼容 OpenClaw 的 Skill 格式，ClawHub 上数千个技能可检索安装；Claude Code 生态的 Skill 也大量互通，本清单的「相关列表」板块有入口。' },
  { q: '怎么安装一个 Skill？', a: '两条路：在应用内技能市场直接搜索安装；或下载 SKILL.md / ZIP 后放入技能目录。不会命令行也没关系，清单里多个仓库附有手把手的 WorkBuddy 安装指南。' },
  { q: '支持哪些系统和平台？', a: '客户端支持 Windows 与 macOS，官网自动识别系统。还可接入微信、企业微信、飞书、钉钉，海外版支持 Slack / Telegram / Discord，手机发指令电脑干活。' },
  { q: '如何向这份清单提交资源？', a: '在 GitHub 仓库发起 PR：附上链接、一句话描述和所属分类即可。先读 CONTRIBUTING.md；只要资源确实有用，自荐也欢迎。清单以 CC0 发布，可自由转载。' },
];

// Pre-compute groups with host
const groups = CATS.map((c, idx) => ({
  key: c.key,
  en: c.en,
  zh: c.zh,
  count: c.items.length,
  num: String(idx + 1).padStart(2, '0'),
  items: c.items.map(i => ({ ...i, host: host(i.url) })),
}));

// Pre-compute prompts with numbers
const promptsList = PROMPTS_DATA.map((p, i) => ({ ...p, num: String(i + 1).padStart(2, '0') }));

// Pre-compute contributors
const contributors = CONTRIBUTORS.map(c => ({
  name: c.name,
  role: c.role,
  url: 'https://github.com/' + c.login,
  avatar: 'https://github.com/' + c.login + '.png?size=120',
}));

// Chip definitions for the filter bar
const chipDefs = [{ key: 'all', label: '全部' }, ...CATS.map(c => ({ key: c.key, label: c.zh }))];
---

<Layout>
  <style is:inline>
    html, body { margin:0; padding:0; background:var(--bgpage); }
    * { box-sizing:border-box; }
    ::selection { background:#12B981; color:#fff; }
    a { color:var(--ink); text-decoration:none; }
    a:hover { color:#12B981; }
    @keyframes wbfloat { 0%,100% { transform:translateY(0); } 50% { transform:translateY(-10px); } }
    [data-wb-vars] { --bgpage:#FFFFFF; --bgsoft:#F5F8F7; --card:#FFFFFF; --cardhover:#FBFEFD; --headbg:rgba(255,255,255,0.88); --ink:#0B0F0E; --t1b:#3B4644; --t2:#5C6664; --t3:#6B7573; --t4:#7A8582; --t5:#8A9491; --t6:#9AA4A1; --line:#E5EAE8; --line2:#F0F3F2; --ghost:#E9EDEB; }
    [data-wb-theme="dark"] { --bgpage:#0F1514; --bgsoft:#121917; --card:#151D1B; --cardhover:#1A2523; --headbg:rgba(15,21,20,0.85); --ink:#F0F4F3; --t1b:#CBD5D1; --t2:#A9B5B1; --t3:#97A39F; --t4:#8A9692; --t5:#75817D; --t6:#616D69; --line:#242E2B; --line2:#1D2724; --ghost:#182220; }
    [data-wb-theme="dark"] #wb-logo { filter:brightness(0) invert(1); }
    [data-wb-theme="dark"] [data-inkbtn] { background:#12B981 !important; }
    @media (max-width:900px) {
      [data-wrap] { padding-left:20px !important; padding-right:20px !important; }
      #wb-nav, #wb-count { display:none !important; }
      #wb-h1 { font-size:46px !important; }
      #wb-hero { padding-top:64px !important; padding-bottom:56px !important; }
      #wb-mascot { width:132px !important; left:4px !important; }
      #wb-stats { margin-top:44px !important; }
      #wb-stats > div { padding:18px 8px !important; }
      #wb-stats > div > div:first-child { font-size:28px !important; }
      #wb-stats > div > div:last-child { font-size:11.5px !important; }
      [data-h2] { font-size:30px !important; }
      [data-split] { grid-template-columns:1fr !important; gap:36px !important; }
      [data-pad] { padding-top:56px !important; padding-bottom:60px !important; }
      #wb-hero-copy { font-size:15.5px !important; }
    }
    @media (max-width:560px) {
      #wb-h1 { font-size:34px !important; }
      #wb-mascot { display:none !important; }
      [data-cta] { width:100% !important; justify-content:center !important; }
    }
  </style>

  <div data-wb-vars="1" data-wb-theme="light" id="wb-root" style="font-family:'Noto Sans SC','Archivo',system-ui,sans-serif; color:var(--ink); background:var(--bgpage); overflow-x:hidden; transition:background .3s ease, color .3s ease;">

    <!-- HEADER -->
    <header style="position:sticky; top:0; z-index:50; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:0 32px; height:68px; display:flex; align-items:center; gap:32px;">
        <a href="https://github.com/staruhub/awesome-workbuddy" style="display:flex; align-items:center;">
          <img id="wb-logo" src={`${base}/uploads/workbuddy-logo.png`} alt="WorkBuddy" style="height:30px; width:auto; display:block;" />
        </a>
        <nav id="wb-nav" style="display:flex; align-items:center; gap:26px; margin-left:8px; font-size:14px; font-weight:500;">
          <a href="#resources" style="color:var(--t2);">资源清单</a>
          <a href="#prompts" style="color:var(--t2);">Prompts</a>
          <a href="https://www.workbuddy.cn/" style="color:var(--t2);">WorkBuddy 官网</a>
        </nav>
        <div style="flex:1;"></div>
        <span id="wb-count" style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t5);">CC0 · 61 resources</span>
        <button id="theme-toggle" title="切换深浅色" style="width:38px; height:38px; border-radius:50%; border:1px solid var(--line); background:var(--card); color:var(--ink); cursor:pointer; font-size:15px; line-height:1; display:flex; align-items:center; justify-content:center;">&#9790;</button>
        <a href="https://github.com/staruhub/awesome-workbuddy" data-inkbtn="1" style="display:inline-flex; align-items:center; gap:8px; background:#0B0F0E; color:#fff; font-size:14px; font-weight:700; padding:11px 22px; border-radius:999px;">Star on GitHub</a>
      </div>
    </header>

    <!-- HERO -->
    <section style="position:relative; overflow:hidden; background:linear-gradient(180deg,var(--bgpage) 0%,var(--bgsoft) 100%); border-bottom:1px solid var(--line);">
      <div style="position:absolute; left:-4%; top:34%; transform:rotate(-24deg); font-family:'Archivo',sans-serif; font-weight:900; font-size:170px; line-height:0.82; color:var(--ghost); letter-spacing:-0.05em; pointer-events:none; user-select:none;">WORK<br/>BUDD&gt;_</div>
      <div style="position:absolute; right:-140px; top:-120px; width:520px; height:520px; border-radius:50%; background:radial-gradient(circle,rgba(18,185,129,0.16),rgba(18,185,129,0) 68%); pointer-events:none;"></div>
      <div style="position:absolute; left:-10%; top:18%; width:120%; height:1px; background:linear-gradient(90deg,rgba(11,15,14,0),rgba(11,15,14,0.09),rgba(11,15,14,0)); transform:rotate(-14deg); pointer-events:none;"></div>
      <div style="position:absolute; left:-10%; top:58%; width:120%; height:1px; background:linear-gradient(90deg,rgba(11,15,14,0),rgba(11,15,14,0.07),rgba(11,15,14,0)); transform:rotate(-14deg); pointer-events:none;"></div>
      <div style="position:absolute; right:16%; top:24%; width:26px; height:26px; background:#12B981; transform:skewY(-14deg); pointer-events:none; box-shadow:0 14px 30px -10px rgba(18,185,129,0.6);"></div>
      <div style="position:absolute; right:13.5%; top:31%; width:12px; height:12px; background:#0B0F0E; transform:skewY(-14deg); pointer-events:none; opacity:0.12;"></div>

      <div data-wrap="1" id="wb-hero" style="position:relative; max-width:1240px; margin:0 auto; padding:104px 32px 76px; text-align:center;">
        <div style="display:inline-flex; align-items:center; gap:10px; background:var(--card); border:1px solid var(--line); border-radius:999px; padding:7px 16px; font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t1b); margin-bottom:34px;">
          <span style="width:7px; height:7px; border-radius:50%; background:#12B981; display:block;"></span>
          Open Source · CC0 License · 社区共建
        </div>

        <h1 id="wb-h1" style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:86px; line-height:0.94; letter-spacing:-0.045em; text-wrap:balance;">
          AWESOME<br/><span style="display:inline-flex; align-items:baseline;">WORKBUDD<span style="color:#12B981;">&gt;_</span></span>
        </h1>

        <p id="wb-hero-copy" style="max-width:660px; margin:30px auto 0; font-size:17px; line-height:1.85; color:var(--t2); text-wrap:pretty;">
          腾讯 WorkBuddy 生态资源精选清单。官方资源、技能插件、提示词工作流、教程、评测与对比，一站式收录，持续更新。
        </p>

        <div style="display:flex; justify-content:center; gap:14px; margin-top:38px; flex-wrap:wrap;">
          <a href="https://github.com/staruhub/awesome-workbuddy" style="display:inline-flex; align-items:center; gap:10px; background:#12B981; color:#fff; font-size:15px; font-weight:700; padding:15px 30px; border-radius:12px; box-shadow:0 10px 24px -12px rgba(18,185,129,0.9);" data-cta="1">★ Star on GitHub</a>
          <a href="https://www.workbuddy.cn/" style="display:inline-flex; align-items:center; gap:10px; background:var(--card); color:var(--ink); border:1px solid var(--line); font-size:15px; font-weight:700; padding:15px 30px; border-radius:12px;" data-cta="1">访问 WorkBuddy 官网 ↗</a>
        </div>

        <div id="wb-stats" data-reveal="1" style="display:flex; justify-content:center; gap:0; margin-top:64px; border:1px solid var(--line); background:var(--card); border-radius:18px; overflow:hidden; max-width:720px; margin-left:auto; margin-right:auto;">
          <div style="flex:1; padding:26px 20px; border-right:1px solid var(--line);">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em;">61</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">个精选资源</div>
          </div>
          <div style="flex:1; padding:26px 20px; border-right:1px solid var(--line);">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em;">9</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">个分类</div>
          </div>
          <div style="flex:1; padding:26px 20px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:38px; letter-spacing:-0.03em; color:#12B981;">100</div>
            <div style="font-size:13px; color:var(--t4); margin-top:4px;">条提效 Prompts</div>
          </div>
        </div>
      </div>
      <img src="https://codebuddy-1328495429.cos.accelerate.myqcloud.com/web/workbuddy/70987efec023ba6c4d65744aafb9fb7c67629a48/assets/scenario1-feature1-BPMObM4f.png" alt="" id="wb-mascot" style="position:absolute; left:24px; bottom:0; width:190px; height:auto; pointer-events:none; user-select:none;" />
    </section>

    <!-- CATEGORY FILTER BAR -->
    <div id="resources" style="position:sticky; top:68px; z-index:40; background:var(--headbg); backdrop-filter:blur(14px); border-bottom:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:14px 32px; display:flex; gap:8px; flex-wrap:wrap; overflow-x:auto;">
        {chipDefs.map(chip => (
          <button data-filter={chip.key} class="wb-chip" style={`border:1px solid ${chip.key === 'all' ? '#12B981' : 'var(--line)'}; background:${chip.key === 'all' ? '#12B981' : 'var(--card)'}; color:${chip.key === 'all' ? '#fff' : 'var(--t2)'}; font-family:'Noto Sans SC',sans-serif; font-size:13.5px; font-weight:700; padding:9px 16px; border-radius:999px; cursor:pointer; transition:all .15s;`}>{chip.label}</button>
        ))}
      </div>
    </div>

    <!-- MAIN RESOURCE DIRECTORY -->
    <main data-wrap="1" data-pad="1" style="max-width:1240px; margin:0 auto; padding:56px 32px 90px;">
      <div style="display:flex; align-items:center; gap:12px; margin-bottom:40px;">
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; letter-spacing:0.08em; color:#12B981;">RESOURCE DIRECTORY</span>
        <span style="flex:1; height:1px; background:var(--line2);"></span>
        <span style="font-family:'JetBrains Mono',monospace; font-size:12px; color:var(--t6);">curated &amp; verified by hand</span>
      </div>
      {groups.map(g => (
        <section data-reveal="1" data-cat={g.key} class="wb-group" style="margin-bottom:64px;">
          <div style="display:flex; align-items:baseline; gap:14px; margin-bottom:6px;">
            <span style="font-family:'JetBrains Mono',monospace; font-size:13px; font-weight:700; color:#12B981;">{g.num}</span>
            <h2 style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:clamp(22px,5.4vw,30px); letter-spacing:-0.03em;">{g.en}</h2>
            <span style="font-family:'JetBrains Mono',monospace; font-size:13px; color:var(--t6);">({g.count})</span>
            <span style="flex:1; height:1px; background:var(--line2); align-self:center;"></span>
          </div>
          <p style="margin:0 0 26px 34px; font-size:14px; color:var(--t4);">{g.zh}</p>
          <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(330px,100%),1fr)); gap:16px;">
            {g.items.map(it => (
              <a href={it.url} target="_blank" rel="noopener noreferrer" style="display:flex; flex-direction:column; background:var(--card); border:1px solid var(--line); border-radius:16px; padding:22px 22px 18px; transition:all .18s;">
                <div style="display:flex; align-items:flex-start; justify-content:space-between; gap:12px;">
                  <h3 style="margin:0; font-size:16.5px; font-weight:700; line-height:1.4; letter-spacing:-0.01em;">{it.title}</h3>
                  <span style="font-family:'Archivo',sans-serif; font-size:16px; color:var(--t6); flex-shrink:0;">↗</span>
                </div>
                <p style="margin:10px 0 0; font-size:13.5px; line-height:1.75; color:var(--t3); text-wrap:pretty;">{it.desc}</p>
                <div style="flex:1; min-height:14px;"></div>
                <div style="margin-top:14px; padding-top:13px; border-top:1px solid var(--line2); font-family:'JetBrains Mono',monospace; font-size:11.5px; color:var(--t6);">{it.host}</div>
              </a>
            ))}
          </div>
        </section>
      ))}
    </main>

    <!-- PROMPTS SECTION -->
    <section id="prompts" data-reveal="1" style="background:#0B0F0E; color:#fff; padding:88px 0 96px; position:relative; overflow:hidden;">
      <div style="position:absolute; right:-90px; bottom:-60px; font-family:'Archivo',sans-serif; font-weight:900; font-size:150px; color:rgba(255,255,255,0.035); letter-spacing:-0.05em; pointer-events:none;">PROMPTS</div>
      <div data-wrap="1" style="position:relative; max-width:1240px; margin:0 auto; padding:0 32px;">
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:30px; flex-wrap:wrap; margin-bottom:40px;">
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#12B981; margin-bottom:14px;">PROMPT LIBRARY</div>
            <h2 data-h2="1" style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:46px; letter-spacing:-0.035em; line-height:1.06;">100 条工作提效 Prompts</h2>
            <p style="margin:16px 0 0; max-width:620px; font-size:15.5px; line-height:1.8; color:#9BA5A2;">10 大办公场景各 10 条，覆盖调研、报表、PPT、纪要、开发、运营，可直接粘贴给 WorkBuddy 抄作业。</p>
          </div>
          <a href="https://github.com/staruhub/awesome-workbuddy/blob/main/prompts/100-work-efficiency-prompts.json" style="display:inline-flex; align-items:center; gap:9px; background:#12B981; color:#fff; font-size:14.5px; font-weight:700; padding:14px 26px; border-radius:12px;">查看全部 100 条 →</a>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(340px,100%),1fr)); gap:16px;">
          {promptsList.map(p => (
            <div style="position:relative; overflow:hidden; background:linear-gradient(160deg,#151C1A,#101614); border:1px solid #232B29; border-radius:16px; padding:24px; display:flex; flex-direction:column;">
              <div style="position:absolute; right:14px; top:2px; font-family:'Archivo',sans-serif; font-weight:900; font-size:64px; color:rgba(255,255,255,0.045); letter-spacing:-0.05em; pointer-events:none;">{p.num}</div>
              <div style="font-family:'JetBrains Mono',monospace; font-size:11px; color:#12B981; letter-spacing:0.04em;">{p.tag}</div>
              <h3 style="margin:12px 0 0; font-size:19px; font-weight:700; line-height:1.4; letter-spacing:-0.015em;">{p.title}</h3>
              <div style="margin-top:8px; font-size:12.5px; color:#7C8784;">{p.who}</div>
              <p style="margin:16px 0 0; font-size:13.5px; line-height:1.8; color:#A8B2AF; text-wrap:pretty;">{p.body}</p>
              <div style="flex:1; min-height:16px;"></div>
              <div style="margin-top:16px; padding:12px 14px; background:rgba(18,185,129,0.08); border-left:2px solid #12B981; border-radius:0 8px 8px 0; font-size:12.5px; line-height:1.65; color:#BFC8C5;">Tip · {p.tip}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- CONTRIBUTORS -->
    <section id="contributors" data-reveal="1" style="background:var(--bgpage); border-top:1px solid var(--line);">
      <div data-wrap="1" data-pad="1" style="max-width:1240px; margin:0 auto; padding:84px 32px 88px;">
        <div style="display:flex; align-items:flex-end; justify-content:space-between; gap:30px; flex-wrap:wrap; margin-bottom:40px;">
          <div>
            <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#12B981; margin-bottom:14px;">CONTRIBUTORS</div>
            <h2 data-h2="1" style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:44px; line-height:1.04; letter-spacing:-0.035em;">贡献者墙</h2>
            <p style="margin:16px 0 0; max-width:620px; font-size:15.5px; line-height:1.8; color:var(--t2); text-wrap:pretty;">这份清单由社区一条条手工筛选、验证、更新。下面是提交过资源、技能、教程与修订的伙伴们。</p>
          </div>
          <a href="https://github.com/staruhub/awesome-workbuddy/blob/main/CONTRIBUTING.md" data-inkbtn="1" style="display:inline-flex; align-items:center; gap:9px; background:#0B0F0E; color:#fff; font-size:14.5px; font-weight:700; padding:14px 26px; border-radius:12px;">成为贡献者 →</a>
        </div>

        <div style="display:grid; grid-template-columns:repeat(auto-fill,minmax(min(178px,100%),1fr)); gap:12px;">
          {contributors.map(c => (
            <a href={c.url} target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:12px; border:1px solid var(--line); border-radius:14px; padding:12px 14px; transition:all .16s;">
              <span style={`width:38px; height:38px; border-radius:50%; display:block; flex-shrink:0; background-color:var(--line2); background-size:cover; background-position:center; background-image:url(${c.avatar});`}></span>
              <span style="min-width:0;">
                <span style="display:block; font-size:13.5px; font-weight:700; letter-spacing:-0.01em; overflow:hidden; text-overflow:ellipsis; white-space:nowrap;">{c.name}</span>
                <span style="display:block; font-family:'JetBrains Mono',monospace; font-size:10.5px; color:var(--t6); margin-top:3px;">{c.role}</span>
              </span>
            </a>
          ))}
        </div>

        <div style="margin-top:20px; display:flex; align-items:center; gap:14px; flex-wrap:wrap; font-size:13.5px; color:var(--t4);">
          <span style="display:inline-flex; align-items:center; gap:8px; border:1px dashed var(--line); border-radius:999px; padding:9px 16px;">
            <span style="width:7px; height:7px; border-radius:50%; background:#12B981; display:block;"></span>
            还有更多提交 Issue、纠错与补链接的伙伴，感谢每一次 PR
          </span>
        </div>
      </div>
    </section>

    <!-- ENGLISH ABOUT -->
    <section id="english" data-reveal="1" style="background:var(--bgsoft); border-top:1px solid var(--line);">
      <div data-wrap="1" data-pad="1" data-split="1" style="max-width:1240px; margin:0 auto; padding:84px 32px 88px; display:grid; grid-template-columns:minmax(300px,0.9fr) 1.1fr; gap:56px; align-items:start;">
        <div>
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#12B981; margin-bottom:14px;">ENGLISH</div>
          <h2 data-h2="1" style="margin:0; font-family:'Archivo',sans-serif; font-weight:900; font-size:44px; line-height:1.02; letter-spacing:-0.035em;">About this list</h2>
          <p style="margin:20px 0 0; font-size:15.5px; line-height:1.85; color:var(--t2); text-wrap:pretty;">A curated, community-maintained index of the Tencent WorkBuddy ecosystem — official resources, skills and plugins, prompt workflows, tutorials, in-depth reviews, comparisons and integrations. Everything is checked by hand and updated as the ecosystem moves.</p>
          <p style="margin:16px 0 0; font-size:15.5px; line-height:1.85; color:var(--t2); text-wrap:pretty;">WorkBuddy is Tencent's desktop AI work agent: it plans a task, calls tools, produces real files, and leaves the process auditable. It is compatible with the OpenClaw skill format, so a large part of that ecosystem works here too.</p>
          <div style="display:flex; gap:12px; margin-top:30px; flex-wrap:wrap;">
            <a href="https://github.com/staruhub/awesome-workbuddy" data-inkbtn="1" style="display:inline-flex; align-items:center; gap:9px; background:#0B0F0E; color:#fff; font-size:14.5px; font-weight:700; padding:14px 26px; border-radius:12px;">★ Star on GitHub</a>
            <a href="https://www.workbuddy.ai/" style="display:inline-flex; align-items:center; gap:9px; background:var(--card); border:1px solid var(--line); color:var(--ink); font-size:14.5px; font-weight:700; padding:14px 26px; border-radius:12px;">Global site ↗</a>
          </div>
        </div>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(min(240px,100%),1fr)); gap:16px;">
          <div style="border:1px solid var(--line); border-radius:16px; padding:24px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:15px; letter-spacing:-0.01em;">What's inside</div>
            <p style="margin:10px 0 0; font-size:13.5px; line-height:1.8; color:var(--t3);">61 links across 9 categories, plus a library of 100 ready-to-paste productivity prompts covering research, reporting, decks, meeting notes, development and ops.</p>
          </div>
          <div style="border:1px solid var(--line); border-radius:16px; padding:24px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:15px; letter-spacing:-0.01em;">How to contribute</div>
            <p style="margin:10px 0 0; font-size:13.5px; line-height:1.8; color:var(--t3);">Open a PR with the link, a one-line description and the category. Read CONTRIBUTING.md first — self-promotion is fine if the resource is genuinely useful.</p>
          </div>
          <div style="border:1px solid var(--line); border-radius:16px; padding:24px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:15px; letter-spacing:-0.01em;">Language note</div>
            <p style="margin:10px 0 0; font-size:13.5px; line-height:1.8; color:var(--t3);">Most linked resources are in Simplified Chinese. Official docs, the global site and the benchmark repo are available in English.</p>
          </div>
          <div style="border:1px solid var(--line); border-radius:16px; padding:24px;">
            <div style="font-family:'Archivo',sans-serif; font-weight:900; font-size:15px; letter-spacing:-0.01em;">License</div>
            <p style="margin:10px 0 0; font-size:13.5px; line-height:1.8; color:var(--t3);">Released under CC0 1.0 Universal — no rights reserved. Copy, remix and redistribute freely, no attribution required.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section id="faq" data-reveal="1" style="background:var(--bgpage); border-top:1px solid var(--line);">
      <div data-wrap="1" data-pad="1" style="max-width:860px; margin:0 auto; padding:84px 32px 88px;">
        <div style="text-align:center; margin-bottom:44px;">
          <div style="font-family:'JetBrains Mono',monospace; font-size:12px; color:#12B981; margin-bottom:14px;">FAQ</div>
          <h2 data-h2="1" style="margin:0; font-family:'Archivo','Noto Sans SC',sans-serif; font-weight:900; font-size:44px; line-height:1.04; letter-spacing:-0.035em;">常见问题</h2>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px;">
          {FAQS.map((f, i) => (
            <div class="wb-faq" data-faq-idx={i} style="border:1px solid var(--line); border-radius:14px; background:var(--card); overflow:hidden; transition:border-color .2s;">
              <button class="wb-faq-btn" style="display:flex; align-items:center; justify-content:space-between; gap:16px; width:100%; text-align:left; background:none; border:none; cursor:pointer; padding:20px 22px; font-family:'Noto Sans SC',sans-serif; font-size:15.5px; font-weight:700; color:var(--ink); letter-spacing:-0.01em;">
                <span>{f.q}</span>
                <span class="wb-faq-mark" style="font-family:'JetBrains Mono',monospace; font-size:16px; color:#12B981; flex-shrink:0;">+</span>
              </button>
              <div class="wb-faq-body" style="display:none; padding:0 22px 20px;">
                <p style="margin:0; font-size:14px; line-height:1.9; color:var(--t3); text-wrap:pretty;">{f.a}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- FOOTER -->
    <section style="background:var(--bgsoft); border-top:1px solid var(--line);">
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:76px 32px 0; display:grid; grid-template-columns:repeat(auto-fit,minmax(min(230px,100%),1fr)); gap:24px;">
        <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:24px;">
          <div style="display:flex; align-items:center; gap:9px; font-size:14.5px; font-weight:700;"><span style="width:7px; height:7px; background:#12B981; display:block;"></span>官方资源</div>
          <div style="height:1px; background:var(--line2); margin:14px 0 16px;"></div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px; color:var(--t3);">
            <a href="https://www.workbuddy.cn/" style="color:var(--t3);">WorkBuddy 国内版</a>
            <a href="https://www.workbuddy.ai/" style="color:var(--t3);">WorkBuddy 海外版</a>
            <a href="https://www.workbuddy.ai/docs/workbuddy/" style="color:var(--t3);">官方文档</a>
          </div>
        </div>
        <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:24px;">
          <div style="display:flex; align-items:center; gap:9px; font-size:14.5px; font-weight:700;"><span style="width:7px; height:7px; background:#12B981; display:block;"></span>本站内容</div>
          <div style="height:1px; background:var(--line2); margin:14px 0 16px;"></div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px; color:var(--t3);">
            <a href="#resources" style="color:var(--t3);">资源清单</a>
            <a href="#prompts" style="color:var(--t3);">100 条 Prompts</a>
          </div>
        </div>
        <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:24px;">
          <div style="display:flex; align-items:center; gap:9px; font-size:14.5px; font-weight:700;"><span style="width:7px; height:7px; background:#12B981; display:block;"></span>参与共建</div>
          <div style="height:1px; background:var(--line2); margin:14px 0 16px;"></div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px; color:var(--t3);">
            <a href="https://github.com/staruhub/awesome-workbuddy/blob/main/CONTRIBUTING.md" style="color:var(--t3);">贡献指南</a>
            <a href="https://github.com/staruhub/awesome-workbuddy" style="color:var(--t3);">提交 Issue / PR</a>
          </div>
        </div>
        <div style="background:var(--card); border:1px solid var(--line); border-radius:14px; padding:24px;">
          <div style="display:flex; align-items:center; gap:9px; font-size:14.5px; font-weight:700;"><span style="width:7px; height:7px; background:#12B981; display:block;"></span>许可</div>
          <div style="height:1px; background:var(--line2); margin:14px 0 16px;"></div>
          <div style="display:flex; flex-direction:column; gap:10px; font-size:13.5px; color:var(--t3);">
            <a href="https://creativecommons.org/publicdomain/zero/1.0/" style="color:var(--t3);">CC0 1.0 Universal</a>
            <span>不保留任何权利</span>
          </div>
        </div>
      </div>
      <div data-wrap="1" style="max-width:1240px; margin:0 auto; padding:44px 32px 0; display:flex; justify-content:space-between; gap:20px; flex-wrap:wrap; font-size:13px; color:var(--t5);">
        <span>Awesome WorkBuddy — 腾讯 WorkBuddy 生态资源精选清单</span>
        <span style="font-family:'JetBrains Mono',monospace;">github.com/staruhub/awesome-workbuddy</span>
      </div>
      <div id="wb-spotlight-wrap" style="overflow:hidden; margin-top:26px; position:relative; cursor:default;">
        <div id="wb-spotlight-text" style="font-family:'Archivo',sans-serif; font-weight:900; font-size:clamp(80px,13.2vw,200px); line-height:0.9; letter-spacing:-0.05em; text-align:center; white-space:nowrap; user-select:none; color:transparent; background:var(--ghost); -webkit-background-clip:text; background-clip:text; transition:background 0s;">WORKBUDD&gt;_</div>
      </div>
    </section>
  </div>

  <script is:inline>
    (function() {
      // Theme toggle
      var root = document.getElementById('wb-root');
      var btn = document.getElementById('theme-toggle');
      var stored = null;
      try { stored = localStorage.getItem('wb-theme'); } catch(e) {}
      if (stored === 'dark' || stored === 'light') {
        root.setAttribute('data-wb-theme', stored);
      }
      function updateIcon() {
        btn.innerHTML = root.getAttribute('data-wb-theme') === 'dark' ? '&#9788;' : '&#9790;';
      }
      updateIcon();
      btn.addEventListener('click', function() {
        var current = root.getAttribute('data-wb-theme');
        var next = current === 'dark' ? 'light' : 'dark';
        root.setAttribute('data-wb-theme', next);
        try { localStorage.setItem('wb-theme', next); } catch(e) {}
        updateIcon();
      });

      // Category filter
      var chips = document.querySelectorAll('.wb-chip');
      var groups = document.querySelectorAll('.wb-group');
      chips.forEach(function(chip) {
        chip.addEventListener('click', function() {
          var key = chip.getAttribute('data-filter');
          chips.forEach(function(c) {
            var isActive = c.getAttribute('data-filter') === key;
            c.style.background = isActive ? '#12B981' : 'var(--card)';
            c.style.color = isActive ? '#fff' : 'var(--t2)';
            c.style.borderColor = isActive ? '#12B981' : 'var(--line)';
          });
          groups.forEach(function(g) {
            if (key === 'all' || g.getAttribute('data-cat') === key) {
              g.style.display = '';
            } else {
              g.style.display = 'none';
            }
          });
        });
      });

      // FAQ accordion
      var faqs = document.querySelectorAll('.wb-faq');
      var openIdx = -1;
      faqs.forEach(function(faq) {
        var btnEl = faq.querySelector('.wb-faq-btn');
        var body = faq.querySelector('.wb-faq-body');
        var mark = faq.querySelector('.wb-faq-mark');
        btnEl.addEventListener('click', function() {
          var idx = parseInt(faq.getAttribute('data-faq-idx'));
          if (openIdx === idx) {
            body.style.display = 'none';
            mark.textContent = '+';
            faq.style.borderColor = 'var(--line)';
            openIdx = -1;
          } else {
            faqs.forEach(function(f) {
              f.querySelector('.wb-faq-body').style.display = 'none';
              f.querySelector('.wb-faq-mark').textContent = '+';
              f.style.borderColor = 'var(--line)';
            });
            body.style.display = 'block';
            mark.textContent = '-';
            faq.style.borderColor = '#12B981';
            openIdx = idx;
          }
        });
      });

      // Scroll reveal with IntersectionObserver
      var revealEls = document.querySelectorAll('[data-reveal]');
      var io = new IntersectionObserver(function(entries) {
        entries.forEach(function(e) {
          if (e.isIntersecting) {
            e.target.style.opacity = '1';
            e.target.style.transform = 'translateY(0)';
            io.unobserve(e.target);
          }
        });
      }, { threshold: 0.08, rootMargin: '0px 0px -6% 0px' });

      revealEls.forEach(function(el) {
        var r = el.getBoundingClientRect();
        if (r.top < window.innerHeight * 0.92) return;
        el.style.opacity = '0';
        el.style.transform = 'translateY(26px)';
        el.style.transition = 'opacity .65s ease, transform .65s cubic-bezier(0.16,1,0.3,1)';
        io.observe(el);
      });
      // Cursor spotlight on bottom text
      var spotWrap = document.getElementById('wb-spotlight-wrap');
      var spotText = document.getElementById('wb-spotlight-text');
      if (spotWrap && spotText) {
        spotWrap.addEventListener('mousemove', function(e) {
          var rect = spotWrap.getBoundingClientRect();
          var x = e.clientX - rect.left;
          var y = e.clientY - rect.top;
          spotText.style.background = 'radial-gradient(circle 180px at ' + x + 'px ' + y + 'px, #12B981 0%, var(--ghost) 100%)';
          spotText.style.webkitBackgroundClip = 'text';
          spotText.style.backgroundClip = 'text';
        });
        spotWrap.addEventListener('mouseleave', function() {
          spotText.style.background = 'var(--ghost)';
          spotText.style.webkitBackgroundClip = 'text';
          spotText.style.backgroundClip = 'text';
        });
      }

    })();
  </script>
</Layout>
